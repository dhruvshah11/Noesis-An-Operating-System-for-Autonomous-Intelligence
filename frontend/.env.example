# Next.js / Noesis Frontend env (copy to .env.local for development)

# Base URL of the Noesis backend (FastAPI).  Must match a CORS origin
# configured on the backend (by default, http://localhost:3000 is allowed).
BACKEND_BASE_URL=http://localhost:8000

# Leave default unless you have a proxy path-based setup
NEXT_PUBLIC_API_BASE=/api/backend/v1

# Auth (optional — if JWT secret is shared manually for token signing test keys)
# NEXT_PUBLIC_AUTH_MODE=jwt
