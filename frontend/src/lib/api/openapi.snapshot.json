  "components": {
    "schemas": {
      "APIEnvelope_dict_": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "meta": {
            "additionalProperties": true,
            "type": "object",
            "title": "Meta"
          }
        },
        "type": "object",
        "required": [
          "ok"
        ],
        "title": "APIEnvelope[dict]"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 2,
            "title": "User Id"
          },
          "password": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 8,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "password"
        ],
        "title": "LoginRequest"
      },
      "MeResponse": {
        "properties": {
          "sub": {
            "type": "string",
            "title": "Sub"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Roles"
          },
          "jti": {
            "type": "string",
            "title": "Jti"
          },
          "issued_at": {
            "type": "string",
            "title": "Issued At"
          },
          "expires_at": {
            "type": "string",
            "title": "Expires At"
          },
          "token_use": {
            "type": "string",
            "title": "Token Use",
            "default": "access"
          }
        },
        "type": "object",
        "required": [
          "sub",
          "roles",
          "jti",
          "issued_at",
          "expires_at"
        ],
        "title": "MeResponse"
      },
      "ObservabilitySummary": {
        "properties": {
          "window_s": {
            "type": "integer",
            "title": "Window S"
          },
          "total_requests": {
            "type": "integer",
            "title": "Total Requests"
          },
          "total_token_cost_usd": {
            "type": "number",
            "title": "Total Token Cost Usd"
          },
          "total_prompt_tokens": {
            "type": "integer",
            "title": "Total Prompt Tokens"
          },
          "total_completion_tokens": {
            "type": "integer",
            "title": "Total Completion Tokens"
          },
          "latency_p50_ms": {
            "type": "integer",
            "title": "Latency P50 Ms"
          },
          "latency_p95_ms": {
            "type": "integer",
            "title": "Latency P95 Ms"
          },
          "tools": {
            "items": {
              "$ref": "#/components/schemas/ToolTraceSummary"
            },
            "type": "array",
            "title": "Tools"
          },
          "errors": {
            "type": "integer",
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "window_s",
          "total_requests",
          "total_token_cost_usd",
          "total_prompt_tokens",
          "total_completion_tokens",
          "latency_p50_ms",
          "latency_p95_ms",
          "tools",
          "errors"
        ],
        "title": "ObservabilitySummary"
      },
      "TokenPair": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "Bearer"
          },
          "expires_in_s": {
            "type": "integer",
            "title": "Expires In S"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "refresh_token",
          "expires_in_s"
        ],
        "title": "TokenPair"
      },
      "ToolTraceSummary": {
        "properties": {
          "tool_name": {
            "type": "string",
            "title": "Tool Name"
          },
          "invocations": {
            "type": "integer",
            "title": "Invocations"
          },
          "p50_ms": {
            "type": "integer",
            "title": "P50 Ms"
          },
          "p95_ms": {
            "type": "integer",
            "title": "P95 Ms"
          },
          "total_ms": {
            "type": "integer",
            "title": "Total Ms"
          },
          "errors": {
            "type": "integer",
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "tool_name",
          "invocations",
          "p50_ms",
          "p95_ms",
          "total_ms",
          "errors"
        ],
        "title": "ToolTraceSummary"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
