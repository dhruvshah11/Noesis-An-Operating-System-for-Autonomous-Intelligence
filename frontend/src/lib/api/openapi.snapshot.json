{
  "openapi": "3.1.0",
  "info": {
    "title": "AstraOS API",
    "description": "AstraOS — The Autonomous Multi-Agent AI Operating System.  Multi-agent orchestration with long-term memory, RAG, tool-calling, planning, and self-reflection.  All public routes live under `/v1` for semantic URL versioning.",
    "termsOfService": "https://github.com/astraos/astraos/blob/main/TERMS.md",
    "contact": {
      "name": "AstraOS Maintainers",
      "url": "https://github.com/astraos/astraos",
      "email": "maintainers@astraos.dev"
    },
    "license": {
      "name": "MIT License",
      "url": "https://github.com/astraos/astraos/blob/main/LICENSE"
    },
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/v1",
      "description": "v1 API (current)"
    },
    {
      "url": "/",
      "description": "Root (legacy redirects to /v1)"
    }
  ],
